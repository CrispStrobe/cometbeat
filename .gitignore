# Miscellaneous
*.class
*.log
*.pyc
*.swp
# Merge/patch detritus — never meant to be committed (a broad `git add` once
# swept .orig/.bak2/.rej scratch into the tree, breaking analyze).
*.orig
*.rej
*.bak
*.bak2
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# `build` is a symlink to an external SSD on the dev machine (disk-volume
# policy); a plain `/build/` only matches a real dir, so match the symlink too.
/build
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.vercel

# Vercel staging copy (build/web lives on the SSD via symlink)
/deploy_web/

# Local dev notes (never shared)
CLAUDE.md
test/fixtures/wild_local.*
# Real tracker modules for local parser validation — copyrighted music, never
# committed; fetched by bin/fetch_wild_modules.dart, tested by module_wild_test.
test/fixtures/wild/
# The tracker-audit corpus (see test/fixtures/README.md): real modules from
# ModArchive / Amiga Music Preservation, © their authors and NOT open-source, so
# they live only in a developer checkout. They were committed by accident once
# (bb5a5bee) despite that README and the header of
# test/tracker_audio_regression_test.dart both saying not to — these rules stop
# it recurring. Only the synthetic golden.{mod,xm,it,s3m} fixtures are safe to
# commit; golden.mod.wav is a RENDER of one of these modules, so it inherits
# their licence and is excluded too.
test/fixtures/_dont_look_back_.xm
test/fixtures/buddhia3.it
test/fixtures/wonderfulpain.it
test/fixtures/mobile.mod
test/fixtures/mulju_the_clown.mod
test/fixtures/powerbase.mod
test/fixtures/golden.mod.wav
native/glint/src/.testbuild/

# Android NDK/CMake build output (externalNativeBuild). Never commit it.
.cxx/

# Pre-baked neural narration WAVs — generated at deploy by tool/bake_narration.dart
# (CI-baked from tool/narration_strings.json), never committed. Manifest stays {}.
assets/narration/*.wav

# iOS HD TTS framework — fetched in CI from a CrispASR release, never committed
ios/Frameworks/crispasr.xcframework

# Android HD TTS libs — fetched in CI from a CrispASR release, never committed
android/app/src/main/jniLibs/
